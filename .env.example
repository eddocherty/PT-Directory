# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only for scripts/import-trainers.mjs. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://your-domain.co.uk
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.co.uk

# Stripe (shop). Secret key from Stripe dashboard > Developers > API keys. Add it in Vercel, never commit it.
STRIPE_SECRET_KEY=
# Unlocks the encrypted plan PDFs in private/plans (base64, 32 bytes). Set on Vercel only.
PLANS_KEY=
